# Copy to .env and adjust. Validated at startup by src/config/env.ts
NODE_ENV=development
PORT=4000
# Allowed CORS origin (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# MongoDB connection string (e.g. Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net). Never commit the real value.
MONGODB_URI=
MONGODB_DB_NAME=teamchatai
# Signs access tokens (HS256). At least 32 chars; generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Access token lifetime in seconds (900 = 15 min). Shorten (e.g. 30) to test silent refresh.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# strict | lax | none (none only works in production, because it requires Secure cookies)
COOKIE_SAMESITE=strict

# AI assistant (Google Gemini). Get a key at https://aistudio.google.com (Get API key).
GEMINI_API_KEY=
# A current Flash model from AI Studio's model list (a "-lite" one answers fastest).
AI_MODEL=gemini-3.5-flash-lite

# File uploads (Cloudinary). Console → Settings → API Keys. The secret only signs uploads on
# the server; the browser never sees it. Also enable PDF delivery (Settings → Security).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis: start it with `docker compose up -d`. Without it the AI daily limit isn't enforced.
REDIS_URL=redis://localhost:6379
# Tokens (input + output) each user may spend on AI per day.
AI_DAILY_TOKEN_LIMIT=50000
# The allowance resets at midnight in this IANA timezone (e.g. Asia/Kolkata).
AI_USAGE_TIMEZONE=UTC

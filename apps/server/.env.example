# Copy to .env and adjust. Validated at startup by src/config/env.ts
NODE_ENV=development
PORT=4000
# Allowed CORS origin (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# MongoDB connection string (e.g. Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net). Never commit the real value.
MONGODB_URI=
MONGODB_DB_NAME=teamchatai
